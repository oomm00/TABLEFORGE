# TableForge AI — Environment Variables
# Copy this file to .env.local and fill in your values.
# The app works without a key — it falls back to realistic mock responses.

# Gemini API key for real NL -> SQL generation (optional)
GEMINI_API_KEY=your_api_key_here

# Optional: PostgreSQL for live data (app works without this)
# DATABASE_URL=postgresql://user:pass@localhost:5432/mydb
